{
  "name": "@ftops/email-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler build",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier \"**/*.{ts,json,md}\" --write",
    "format:check": "prettier \"**/*.{ts,json,md}\" --check",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "deploy:unsafe": "wrangler deploy",
    "deploy": "npm run verify && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260116.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.17",
    "wrangler": "^4.59.2"
  }
}
